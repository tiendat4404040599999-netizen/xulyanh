{% extends "base.html" %} {% block title %}Cấu hình hệ thống & Huấn luyện AI{%
endblock %} {% block content %}
<div class="space-y-6">
  <div>
    <h2 class="text-2xl font-bold text-cyan-400">
      Cấu hình tham số, Mô hình & Huấn luyện AI
    </h2>
    <p class="text-sm text-slate-400 mt-1">
      Thiết lập nguồn camera 1280×720, ngưỡng sinh trắc học, ngưỡng tin cậy &
      bước trượt suy luận (60 khung hình), nạp trọng số hoặc huấn luyện lại
      BiGRU.
    </p>
  </div>

  <div
    id="cfg-toast"
    class="hidden p-3.5 rounded-xl text-sm font-medium border"
  ></div>

  <!-- KHỐI 1: CẤU HÌNH PHẦN CỨNG, NGƯỠNG CẢNH BÁO & THAM SỐ SUY LUẬN AI -->
  <form
    id="config-form"
    onsubmit="saveConfig(event)"
    class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-6"
  >
    <div
      class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3"
    >
      <h3 class="text-base font-bold text-slate-100">
        1. Tham số thiết bị ghi hình, Công thái học & Suy luận BiGRU
      </h3>
      <span class="text-xs font-mono text-slate-400"
        >Tệp thiết lập:
        <strong class="text-cyan-300">data/system_settings.json</strong></span
      >
    </div>

    <!-- Nguồn camera & chuẩn phân giải -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 text-sm">
      <div class="md:col-span-8">
        <label class="block text-xs text-slate-300 mb-1.5 font-semibold"
          >Nguồn Camera (0 = Webcam laptop hoặc URL IP Camera điện thoại)</label
        >
        <input
          id="camera_source"
          type="text"
          required
          value="{{ config.camera_source }}"
          placeholder="0 hoặc http://192.168.x.x:8080/video"
          class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-700 text-cyan-300 font-mono text-sm focus:outline-none focus:border-cyan-400"
        />
      </div>
      <div class="md:col-span-4">
        <label class="block text-xs text-slate-300 mb-1.5 font-semibold"
          >Chuẩn phân giải đầu vào</label
        >
        <input
          type="text"
          disabled
          value="1280 × 720 (HD Letterbox)"
          class="w-full px-3.5 py-2 rounded-xl bg-slate-950/60 border border-slate-800 text-slate-400 font-mono text-sm"
        />
      </div>
    </div>

    <!-- BỔ SUNG NHÓM 4: NGƯỠNG TIN CẬY (SLIDER %) & BƯỚC TRƯỢT DỰ ĐOÁN (SỐ KHUNG HÌNH) -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-5 p-4 rounded-2xl bg-slate-950/75 border border-cyan-500/30"
    >
      <!-- Thanh trượt Slider phần trăm ngưỡng tin cậy dự đoán -->
      <div class="space-y-2.5">
        <div class="flex items-center justify-between">
          <label
            for="confidence_threshold"
            class="text-xs font-bold text-cyan-300 uppercase tracking-wider"
          >
            Ngưỡng tin cậy dự đoán tối thiểu
          </label>
          <span
            id="conf-slider-value"
            class="px-2.5 py-0.5 rounded-lg bg-cyan-500/20 border border-cyan-500/40 text-cyan-200 font-mono text-sm font-extrabold"
          >
            {{ config.confidence_threshold | int }}%
          </span>
        </div>
        <input
          id="confidence_threshold"
          type="range"
          min="0"
          max="95"
          step="1"
          value="{{ config.confidence_threshold | int }}"
          oninput="updateConfidenceSliderUI(this.value)"
          class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400"
        />
        <div class="flex justify-between text-[11px] text-slate-500 font-mono">
          <span>0% (Luôn nhận)</span>
          <span>40% (Khuyến nghị)</span>
          <span>95% (Rất chặt)</span>
        </div>
        <p class="text-xs text-slate-400">
          Khi xác suất dự đoán cao nhất thấp hơn mức này, hệ thống sẽ hiển thị
          trạng thái
          <strong class="text-amber-300">"Không xác định"</strong> thay vì nhãn
          kém tin cậy.
        </p>
      </div>

      <!-- Ô nhập số khung hình bước trượt dự đoán -->
      <div class="space-y-2.5">
        <div class="flex items-center justify-between">
          <label
            for="inference_stride"
            class="text-xs font-bold text-cyan-300 uppercase tracking-wider"
          >
            Bước trượt dự đoán (trên cửa sổ 60 khung hình)
          </label>
          <span
            id="stride-badge"
            class="px-2.5 py-0.5 rounded-lg bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-[11px] font-semibold"
          >
            Cân bằng
          </span>
        </div>
        <div class="flex items-center gap-3">
          <input
            id="inference_stride"
            type="number"
            min="1"
            max="60"
            step="1"
            required
            value="{{ config.inference_stride }}"
            oninput="updateStrideBadge(this.value)"
            class="w-32 px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-700 text-cyan-300 font-mono text-base font-bold focus:outline-none focus:border-cyan-400"
          />
          <span class="text-xs text-slate-300"
            >khung hình / 1 lần suy luận BiGRU</span
          >
        </div>
        <p class="text-xs text-slate-400">
          Số khung hình giữa hai lần dự đoán liên tiếp (từ
          <strong class="text-slate-200">1</strong> đến
          <strong class="text-slate-200">60</strong>). Giá trị nhỏ cho kết quả
          mượt hơn; giá trị lớn giúp giảm tải CPU/GPU.
        </p>
      </div>
    </div>

    <!-- Ngưỡng sinh trắc học buồn ngủ & công thái học -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
      <div>
        <label class="block text-xs text-slate-400 mb-1"
          >EAR Mức 1 (Mệt mỏi)</label
        >
        <input
          id="ear_thresh_1"
          type="number"
          step="0.01"
          required
          value="{{ config.ear_thresh_1 }}"
          class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 font-mono"
        />
      </div>
      <div>
        <label class="block text-xs text-slate-400 mb-1"
          >EAR Mức 2 (Nguy hiểm)</label
        >
        <input
          id="ear_thresh_2"
          type="number"
          step="0.01"
          required
          value="{{ config.ear_thresh_2 }}"
          class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 font-mono"
        />
      </div>
      <div>
        <label class="block text-xs text-slate-400 mb-1"
          >PERCLOS Mức 1 (%)</label
        >
        <input
          id="perclos_thresh_1"
          type="number"
          step="1"
          required
          value="{{ config.perclos_thresh_1 }}"
          class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 font-mono"
        />
      </div>
      <div>
        <label class="block text-xs text-slate-400 mb-1"
          >PERCLOS Mức 2 (%)</label
        >
        <input
          id="perclos_thresh_2"
          type="number"
          step="1"
          required
          value="{{ config.perclos_thresh_2 }}"
          class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 font-mono"
        />
      </div>
      <div>
        <label class="block text-xs text-slate-400 mb-1"
          >Góc cúi cổ tối đa (°)</label
        >
        <input
          id="max_neck_angle"
          type="number"
          step="1"
          required
          value="{{ config.max_neck_angle }}"
          class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 font-mono"
        />
      </div>
      <div>
        <label class="block text-xs text-slate-400 mb-1"
          >Độ lệch vai tối đa (°)</label
        >
        <input
          id="max_shoulder_tilt"
          type="number"
          step="1"
          required
          value="{{ config.max_shoulder_tilt }}"
          class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 font-mono"
        />
      </div>
      <div>
        <label class="block text-xs text-slate-400 mb-1"
          >Ngưỡng RULA cảnh báo</label
        >
        <input
          id="max_rula_score"
          type="number"
          step="0.5"
          required
          value="{{ config.max_rula_score }}"
          class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 font-mono"
        />
      </div>
      <div class="flex items-end">
        <button
          type="submit"
          class="w-full py-2.5 px-4 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-sm transition shadow-lg shadow-cyan-500/20"
        >
          Lưu toàn bộ cấu hình
        </button>
      </div>
    </div>
  </form>

  <!-- KHỐI 2 & 3: QUẢN LÝ TRỌNG SỐ & HUẤN LUYỆN MÔ HÌNH -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Tải lên trọng số kiểm duyệt 22x15 -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
      <h3
        class="text-base font-bold text-slate-100 border-b border-slate-800 pb-3"
      >
        2. Nạp trọng số mô hình (.pth)
      </h3>
      <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 text-xs">
        <span class="text-slate-400">Trọng số đang kích hoạt:</span>
        <div
          id="active-model-text"
          class="font-mono text-emerald-300 mt-1 break-all"
        >
          {{ config.active_model_path }}
        </div>
      </div>
      <p class="text-xs text-slate-400">
        Hệ thống tự động kiểm duyệt cấu trúc đầu vào
        <strong>22 đặc trưng</strong> và đầu ra
        <strong>15 lớp cảm xúc</strong> trước khi nạp nóng vào bộ nhớ suy luận.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <input
          id="weights-file-input"
          type="file"
          accept=".pth,.h5"
          class="text-xs text-slate-400 file:mr-2.5 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-slate-800 file:text-cyan-300 hover:file:bg-slate-700 cursor-pointer"
        />
        <button
          type="button"
          onclick="uploadWeights()"
          class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs transition"
        >
          Kiểm tra & Nạp trọng số
        </button>
      </div>
    </div>

    <!-- Huấn luyện lại mô hình BiGRU -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
      <div
        class="flex items-center justify-between border-b border-slate-800 pb-3"
      >
        <h3 class="text-base font-bold text-slate-100">
          3. Huấn luyện lại mô hình BiGRU
        </h3>
        <span class="text-xs text-cyan-300 font-mono"
          >Kho ảnh hiện có: {{ existing_images_count }} ảnh</span
        >
      </div>

      <div class="space-y-3 text-xs">
        <div>
          <label class="block text-slate-300 mb-1"
            >Tải lên gói ảnh tiền xử lý (.zip — tùy chọn)</label
          >
          <input
            id="dataset-zip-input"
            type="file"
            accept=".zip"
            class="w-full text-xs text-slate-400 file:mr-2.5 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-slate-800 file:text-indigo-300 hover:file:bg-slate-700 cursor-pointer"
          />
        </div>

        <div class="grid grid-cols-2 gap-3 items-center">
          <div>
            <label class="block text-slate-300 mb-1"
              >Số vòng huấn luyện (Epochs)</label
            >
            <input
              id="train-epochs"
              type="number"
              min="2"
              max="100"
              value="20"
              class="w-full px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 font-mono"
            />
          </div>
          <div class="space-y-1.5 pt-4">
            <label
              class="flex items-center gap-2 text-slate-300 cursor-pointer"
            >
              <input
                id="chk-skip-extract"
                type="checkbox"
                class="accent-cyan-400"
              />
              <span>Dùng lại tập .npy có sẵn</span>
            </label>
            <label
              class="flex items-center gap-2 text-slate-300 cursor-pointer"
            >
              <input
                id="chk-replace-imgs"
                type="checkbox"
                class="accent-cyan-400"
              />
              <span>Thay thế kho ảnh cũ</span>
            </label>
          </div>
        </div>

        <button
          id="btn-start-train"
          type="button"
          onclick="startTraining()"
          class="w-full py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs transition"
        >
          Bắt đầu huấn luyện mô hình AI
        </button>

        <!-- Thanh tiến độ huấn luyện -->
        <div
          class="p-3 rounded-xl bg-slate-950 border border-slate-800 space-y-2"
        >
          <div class="flex justify-between text-[11px]">
            <span id="train-status-msg" class="text-slate-300"
              >Chưa có tiến trình huấn luyện nào đang chạy.</span
            >
            <span
              id="train-pct-text"
              class="font-mono text-indigo-300 font-bold"
              >0%</span
            >
          </div>
          <div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden">
            <div
              id="train-progress-bar"
              class="h-full bg-indigo-500 transition-all duration-300"
              style="width: 0%"
            ></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function showCfgToast(msg, isErr = false) {
    const el = document.getElementById("cfg-toast");
    el.textContent = msg;
    el.className = isErr
      ? "p-3.5 rounded-xl text-sm font-medium border bg-rose-500/15 border-rose-500/40 text-rose-300"
      : "p-3.5 rounded-xl text-sm font-medium border bg-emerald-500/15 border-emerald-500/40 text-emerald-300";
    el.classList.remove("hidden");
  }

  function updateConfidenceSliderUI(val) {
    document.getElementById("conf-slider-value").textContent =
      `${Number(val).toFixed(0)}%`;
  }

  function updateStrideBadge(val) {
    const n = Number(val);
    const badge = document.getElementById("stride-badge");
    if (!Number.isFinite(n) || n < 1 || n > 60) {
      badge.className =
        "px-2.5 py-0.5 rounded-lg bg-rose-500/20 border border-rose-500/40 text-rose-300 text-[11px] font-semibold";
      badge.textContent = "Ngoài phạm vi (1–60)";
    } else if (n <= 3) {
      badge.className =
        "px-2.5 py-0.5 rounded-lg bg-amber-500/15 border border-amber-500/40 text-amber-300 text-[11px] font-semibold";
      badge.textContent = "Rất mượt • Tải cao";
    } else if (n <= 10) {
      badge.className =
        "px-2.5 py-0.5 rounded-lg bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-[11px] font-semibold";
      badge.textContent = "Cân bằng tối ưu";
    } else {
      badge.className =
        "px-2.5 py-0.5 rounded-lg bg-sky-500/15 border border-sky-500/40 text-sky-300 text-[11px] font-semibold";
      badge.textContent = "Tiết kiệm tài nguyên";
    }
  }

  async function saveConfig(e) {
    e.preventDefault();
    const strideVal = parseInt(
      document.getElementById("inference_stride").value,
      10,
    );
    const confVal = parseFloat(
      document.getElementById("confidence_threshold").value,
    );

    if (Number.isNaN(strideVal) || strideVal < 1 || strideVal > 60) {
      showCfgToast(
        "Bước trượt dự đoán phải nằm trong khoảng từ 1 đến 60 khung hình.",
        true,
      );
      return;
    }

    const payload = {
      camera_source: document.getElementById("camera_source").value,
      ear_thresh_1: parseFloat(document.getElementById("ear_thresh_1").value),
      ear_thresh_2: parseFloat(document.getElementById("ear_thresh_2").value),
      perclos_thresh_1: parseFloat(
        document.getElementById("perclos_thresh_1").value,
      ),
      perclos_thresh_2: parseFloat(
        document.getElementById("perclos_thresh_2").value,
      ),
      max_neck_angle: parseFloat(
        document.getElementById("max_neck_angle").value,
      ),
      max_shoulder_tilt: parseFloat(
        document.getElementById("max_shoulder_tilt").value,
      ),
      max_rula_score: parseFloat(
        document.getElementById("max_rula_score").value,
      ),
      confidence_threshold: confVal,
      inference_stride: strideVal,
    };

    const res = await fetch("/api/admin/config", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });
    const data = await res.json();
    showCfgToast(data.message || data.detail, !res.ok);
  }

  async function uploadWeights() {
    const input = document.getElementById("weights-file-input");
    if (!input.files || !input.files[0]) {
      showCfgToast(
        "Vui lòng chọn tệp trọng số (.pth) trước khi tải lên.",
        true,
      );
      return;
    }
    const fd = new FormData();
    fd.append("file", input.files[0]);
    const res = await fetch("/api/admin/upload-weights", {
      method: "POST",
      body: fd,
    });
    const data = await res.json();
    showCfgToast(data.message || data.detail, !res.ok);
    if (res.ok && data.active_model_path) {
      document.getElementById("active-model-text").textContent =
        data.active_model_path;
    }
  }

  async function startTraining() {
    const fd = new FormData();
    const zipInput = document.getElementById("dataset-zip-input");
    if (zipInput.files && zipInput.files[0]) {
      fd.append("dataset_zip", zipInput.files[0]);
    }
    fd.append("epochs", document.getElementById("train-epochs").value);
    fd.append(
      "skip_extraction",
      document.getElementById("chk-skip-extract").checked,
    );
    fd.append(
      "replace_existing",
      document.getElementById("chk-replace-imgs").checked,
    );

    const res = await fetch("/api/admin/train-model", {
      method: "POST",
      body: fd,
    });
    const data = await res.json();
    showCfgToast(data.message || data.detail, !res.ok);
    pollTrainStatus();
  }

  async function pollTrainStatus() {
    try {
      const res = await fetch("/api/admin/train-status");
      if (!res.ok) return;
      const st = await res.json();
      const pct = Number(st.progress_pct || 0);
      document.getElementById("train-status-msg").textContent =
        st.message || "Sẵn sàng";
      document.getElementById("train-pct-text").textContent = `${pct}%`;
      document.getElementById("train-progress-bar").style.width =
        `${Math.min(100, pct)}%`;
      document.getElementById("btn-start-train").disabled = Boolean(
        st.is_running,
      );
    } catch (e) {}
  }

  updateStrideBadge(document.getElementById("inference_stride").value);
  setInterval(pollTrainStatus, 2500);
  pollTrainStatus();
</script>
{% endblock %}
</file>

<file path="app/templates/admin_users.html">
{% extends "base.html" %} {% block title %}Quản lý người dùng & Phân quyền{%
endblock %} {% block content %}
<div class="space-y-6">
  <div>
    <h2 class="text-2xl font-bold text-cyan-400">
      Quản lý tài khoản người dùng
    </h2>
    <p class="text-sm text-slate-400 mt-1">
      Thêm tài khoản mới, phân quyền vai trò, bật/tắt khóa tài khoản bằng nút
      gạt và xóa người dùng cùng dữ liệu phiên liên quan.
    </p>
  </div>

  <div
    id="admin-toast"
    class="hidden p-3.5 rounded-xl text-sm font-medium border"
  ></div>

  <!-- Form Thêm tài khoản người dùng (Role: Admin) -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
    <h3 class="text-sm font-bold uppercase tracking-wider text-cyan-300 mb-4">
      Thêm tài khoản người dùng mới
    </h3>
    <form
      id="create-user-form"
      onsubmit="createUser(event)"
      class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end text-sm"
    >
      <div class="md:col-span-3">
        <label class="block text-xs text-slate-400 mb-1">Họ và tên</label>
        <input
          id="new-fullname"
          type="text"
          required
          placeholder="Nguyễn Văn B"
          class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 focus:outline-none focus:border-cyan-400"
        />
      </div>
      <div class="md:col-span-3">
        <label class="block text-xs text-slate-400 mb-1">Email</label>
        <input
          id="new-email"
          type="email"
          required
          placeholder="user@example.com"
          class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 focus:outline-none focus:border-cyan-400"
        />
      </div>
      <div class="md:col-span-3">
        <label class="block text-xs text-slate-400 mb-1">Mật khẩu tạm</label>
        <input
          id="new-password"
          type="password"
          required
          placeholder="VD: Matkhau123"
          class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 focus:outline-none focus:border-cyan-400"
        />
      </div>
      <div class="md:col-span-1">
        <label class="block text-xs text-slate-400 mb-1">Vai trò</label>
        <select
          id="new-role"
          class="w-full px-2.5 py-2 rounded-xl bg-slate-950 border border-slate-700 text-slate-100"
        >
          <option value="User">User</option>
          <option value="Admin">Admin</option>
        </select>
      </div>
      <div class="md:col-span-2">
        <button
          type="submit"
          class="w-full py-2 px-4 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold transition"
        >
          + Thêm tài khoản
        </button>
      </div>
    </form>
  </div>

  <!-- Bảng danh sách người dùng -->
  <div
    class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl"
  >
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-800/70 text-slate-300 text-xs uppercase">
            <th class="py-3.5 px-4">ID</th>
            <th class="py-3.5 px-4">Tên đăng nhập</th>
            <th class="py-3.5 px-4">Họ và tên</th>
            <th class="py-3.5 px-4">Email</th>
            <th class="py-3.5 px-4">Vai trò</th>
            <th class="py-3.5 px-4">Trạng thái (Khóa / Mở khóa)</th>
            <th class="py-3.5 px-4 text-right">Thao tác</th>
          </tr>
        </thead>
        <tbody id="users-tbody" class="divide-y divide-slate-800 text-sm">
          {% for u in users %}
          <tr id="user-row-{{ u.id }}" class="hover:bg-slate-800/40 transition">
            <td class="py-3.5 px-4 text-slate-400">#{{ u.id }}</td>
            <td class="py-3.5 px-4 font-mono text-cyan-300 text-xs">
              {{ u.username }}
            </td>
            <td class="py-3.5 px-4 font-medium text-slate-100">
              {{ u.full_name }}
            </td>
            <td class="py-3.5 px-4 text-slate-300">{{ u.email }}</td>
            <td class="py-3.5 px-4">
              {% if u.id == user.id %}
              <select
                disabled
                class="px-2.5 py-1 rounded-lg bg-slate-950 border border-slate-700 text-xs text-slate-200 opacity-50"
              >
                <option value="Admin" selected>Admin</option>
              </select>
              {% else %}
              <select
                data-user-id="{{ u.id }}"
                onchange="changeRole(this)"
                class="px-2.5 py-1 rounded-lg bg-slate-950 border border-slate-700 text-xs text-slate-200"
              >
                {% if u.role == "Admin" %}
                <option value="User">User</option>
                <option value="Admin" selected>Admin</option>
                {% else %}
                <option value="User" selected>User</option>
                <option value="Admin">Admin</option>
                {% endif %}
              </select>
              {% endif %}
            </td>
            <td class="py-3.5 px-4">
              {% if u.id == user.id %}
              <span
                class="inline-flex items-center gap-2 text-xs font-semibold text-emerald-300 opacity-75"
              >
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
                Hoạt động
              </span>
              {% else %}
              <label
                class="inline-flex items-center gap-2.5 cursor-pointer select-none"
              >
                {% if u.is_active %}
                <input
                  type="checkbox"
                  class="sr-only peer"
                  checked
                  data-user-id="{{ u.id }}"
                  onchange="toggleStatus(this)"
                />
                {% else %}
                <input
                  type="checkbox"
                  class="sr-only peer"
                  data-user-id="{{ u.id }}"
                  onchange="toggleStatus(this)"
                />
                {% endif %}
                <div
                  class="relative w-11 h-6 bg-rose-600/80 rounded-full peer peer-checked:bg-emerald-500 transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-5"
                ></div>
                {% if u.is_active %}
                <span
                  id="status-label-{{ u.id }}"
                  class="text-xs font-semibold text-emerald-300"
                  >Hoạt động</span
                >
                {% else %}
                <span
                  id="status-label-{{ u.id }}"
                  class="text-xs font-semibold text-rose-400"
                  >Đang bị khóa</span
                >
                {% endif %}
              </label>
              {% endif %}
            </td>
            <td class="py-3.5 px-4 text-right">
              {% if u.id == user.id %}
              <span class="text-xs text-slate-500 italic">Đang đăng nhập</span>
              {% else %}
              <button
                type="button"
                data-user-id="{{ u.id }}"
                data-full-name="{{ u.full_name }}"
                data-email="{{ u.email }}"
                onclick="openDeleteModal(this)"
                class="px-3 py-1.5 rounded-lg bg-rose-600/20 hover:bg-rose-600 text-rose-300 hover:text-white border border-rose-500/40 text-xs font-semibold transition"
              >
                Xóa
              </button>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Hộp thoại xác nhận Xóa tài khoản -->
<div
  id="delete-modal"
  class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4"
>
  <div
    class="w-full max-w-md bg-slate-900 border border-slate-700 rounded-2xl p-6 shadow-2xl space-y-4"
  >
    <h3 class="text-lg font-bold text-rose-400">Xác nhận xóa tài khoản</h3>
    <p class="text-sm text-slate-300">
      Bạn có chắc chắn muốn xóa tài khoản
      <strong id="del-user-name" class="text-white"></strong> (<span
        id="del-user-email"
        class="text-cyan-300"
      ></span
      >)?
    </p>
    <p
      class="text-xs text-rose-300/90 bg-rose-500/10 border border-rose-500/30 p-3 rounded-xl"
    >
      Lưu ý: Hành động này sẽ xóa vĩnh viễn tài khoản cùng toàn bộ lịch sử phiên
      giám sát và nhật ký liên quan. Không thể hoàn tác.
    </p>
    <div class="flex justify-end gap-3 pt-2">
      <button
        type="button"
        onclick="closeDeleteModal()"
        class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition"
      >
        Hủy bỏ
      </button>
      <button
        type="button"
        onclick="confirmDeleteUser()"
        class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold transition"
      >
        Xác nhận xóa
      </button>
    </div>
  </div>
</div>

<script>
  let pendingDeleteId = null;

  function showToast(msg, isErr = false) {
    const el = document.getElementById("admin-toast");
    el.textContent = msg;
    el.className = isErr
      ? "p-3.5 rounded-xl text-sm font-medium border bg-rose-500/15 border-rose-500/40 text-rose-300"
      : "p-3.5 rounded-xl text-sm font-medium border bg-emerald-500/15 border-emerald-500/40 text-emerald-300";
    el.classList.remove("hidden");
  }

  async function createUser(e) {
    e.preventDefault();
    const payload = {
      full_name: document.getElementById("new-fullname").value,
      email: document.getElementById("new-email").value,
      password: document.getElementById("new-password").value,
      role: document.getElementById("new-role").value,
    };
    const res = await fetch("/api/admin/users", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });
    const data = await res.json();
    if (!res.ok) {
      showToast(data.detail || "Không thể thêm tài khoản.", true);
      return;
    }
    showToast(data.message, false);
    setTimeout(() => window.location.reload(), 650);
  }

  async function changeRole(selectEl) {
    const userId = selectEl.dataset.userId;
    const newRole = selectEl.value;
    const res = await fetch(`/api/admin/users/${userId}/role`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ role: newRole }),
    });
    const data = await res.json();
    showToast(data.message || data.detail, !res.ok);
  }

  async function toggleStatus(checkbox) {
    const userId = checkbox.dataset.userId;
    const isActive = checkbox.checked;
    const res = await fetch(`/api/admin/users/${userId}/status`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ is_active: isActive }),
    });
    const data = await res.json();
    if (!res.ok) {
      checkbox.checked = !isActive;
      showToast(data.detail || "Lỗi cập nhật trạng thái.", true);
      return;
    }
    const lbl = document.getElementById(`status-label-${userId}`);
    lbl.textContent = isActive ? "Hoạt động" : "Đang bị khóa";
    lbl.className = isActive
      ? "text-xs font-semibold text-emerald-300"
      : "text-xs font-semibold text-rose-400";
    showToast(data.message, false);
  }

  function openDeleteModal(btn) {
    pendingDeleteId = btn.dataset.userId;
    document.getElementById("del-user-name").textContent = btn.dataset.fullName;
    document.getElementById("del-user-email").textContent = btn.dataset.email;
    document.getElementById("delete-modal").classList.remove("hidden");
  }

  function closeDeleteModal() {
    pendingDeleteId = null;
    document.getElementById("delete-modal").classList.add("hidden");
  }

  async function confirmDeleteUser() {
    if (!pendingDeleteId) return;
    const id = pendingDeleteId;
    closeDeleteModal();

    const res = await fetch(`/api/admin/users/${id}`, { method: "DELETE" });
    const data = await res.json();
    if (!res.ok) {
      showToast(data.detail || "Không thể xóa tài khoản.", true);
      return;
    }
    const row = document.getElementById(`user-row-${id}`);
    if (row) row.remove();
    showToast(data.message, false);
  }
</script>
{% endblock %}
</file>

