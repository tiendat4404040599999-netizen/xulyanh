<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Khôi phục mật khẩu — EMO-POSTURE AI</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body
    class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-4"
  >
    <div
      class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-2xl space-y-5"
    >
      <div class="text-center">
        <h1 class="text-2xl font-extrabold text-cyan-400">
          Khôi phục mật khẩu
        </h1>
        <p class="text-xs text-slate-400 mt-1">
          {% if step == "verify" %} Nhập mã xác nhận đã cấp và thiết lập mật
          khẩu mới {% else %} Nhập email đã đăng ký để nhận mã xác nhận có hiệu
          lực 10 phút {% endif %}
        </p>
      </div>

      {% if error %}
      <div
        class="p-3 rounded-xl bg-rose-500/15 border border-rose-500/40 text-rose-300 text-sm"
      >
        {{ error }}
      </div>
      {% endif %} {% if message %}
      <div
        class="p-3 rounded-xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-sm"
      >
        {{ message }}
      </div>
      {% endif %} {% if demo_code %}
      <div
        class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/40 text-amber-200 text-xs"
      >
        <div class="font-semibold mb-1">
          Mã xác nhận khôi phục (mô phỏng hộp thư local):
        </div>
        <div
          class="text-xl font-mono font-extrabold tracking-widest text-amber-300"
        >
          {{ demo_code }}
        </div>
      </div>
      {% endif %} {% if step == "verify" %}
      <form method="POST" action="/forgot-password/reset" class="space-y-4">
        <input type="hidden" name="email" value="{{ email }}" />
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5"
            >Email khôi phục</label
          >
          <input
            type="text"
            disabled
            value="{{ email }}"
            class="w-full px-3.5 py-2 rounded-xl bg-slate-950/60 border border-slate-800 text-slate-400 text-sm"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5"
            >Mã xác nhận (6 chữ số)</label
          >
          <input
            name="code"
            type="text"
            required
            placeholder="Nhập mã 6 số"
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-cyan-300 font-mono text-sm focus:outline-none focus:border-cyan-400"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5"
            >Mật khẩu mới</label
          >
          <input
            name="new_password"
            type="password"
            required
            placeholder="Tối thiểu 8 ký tự (chữ hoa, thường, số)"
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 text-sm focus:outline-none focus:border-cyan-400"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5"
            >Xác nhận mật khẩu mới</label
          >
          <input
            name="confirm_password"
            type="password"
            required
            placeholder="Nhập lại mật khẩu mới"
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 text-sm focus:outline-none focus:border-cyan-400"
          />
        </div>
        <button
          type="submit"
          class="w-full py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm transition"
        >
          Đặt lại mật khẩu
        </button>
      </form>
      {% else %}
      <form method="POST" action="/forgot-password/request" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5"
            >Địa chỉ Email đã đăng ký</label
          >
          <input
            name="email"
            type="email"
            required
            value="{{ email }}"
            placeholder="email@example.com"
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-slate-100 text-sm focus:outline-none focus:border-cyan-400"
          />
        </div>
        <button
          type="submit"
          class="w-full py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-sm transition"
        >
          Gửi yêu cầu
        </button>
      </form>
      {% endif %}

      <div
        class="pt-4 border-t border-slate-800 text-center text-xs text-slate-400"
      >
        <a href="/login" class="text-cyan-400 hover:text-cyan-300 font-semibold"
          >← Quay lại trang Đăng nhập</a
        >
      </div>
    </div>
  </body>
</html>
