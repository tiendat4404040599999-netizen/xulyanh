<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      {% block title %}Hệ thống Dự đoán Cảm xúc & Tư thế{% endblock %}
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body
    class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans"
  >
    {% if user %}
    <nav class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-6">
            <span class="text-cyan-400 font-bold tracking-wide text-lg">
              EMO-POSTURE AI
            </span>
            <div class="hidden md:flex items-center gap-2 text-sm">
              <a
                href="/monitor"
                class="px-3 py-2 rounded-lg transition {% if active_nav == 'monitor' %}bg-cyan-500/20 text-cyan-300 font-semibold{% else %}text-slate-300 hover:bg-slate-800{% endif %}"
              >
                Giám sát trực tuyến
              </a>
              <a
                href="/history"
                class="px-3 py-2 rounded-lg transition {% if active_nav == 'history' %}bg-cyan-500/20 text-cyan-300 font-semibold{% else %}text-slate-300 hover:bg-slate-800{% endif %}"
              >
                Lịch sử & Thống kê
              </a>
              {% if user.role == 'Admin' %}
              <a
                href="/admin/users"
                class="px-3 py-2 rounded-lg transition {% if active_nav == 'admin_users' %}bg-cyan-500/20 text-cyan-300 font-semibold{% else %}text-slate-300 hover:bg-slate-800{% endif %}"
              >
                Quản trị tài khoản
              </a>
              <a
                href="/admin/config"
                class="px-3 py-2 rounded-lg transition {% if active_nav == 'config' %}bg-cyan-500/20 text-cyan-300 font-semibold{% else %}text-slate-300 hover:bg-slate-800{% endif %}"
              >
                Cấu hình & Mô hình AI
              </a>
              {% endif %}
            </div>
          </div>

          <div class="flex items-center gap-4">
            <a
              href="/profile"
              class="flex items-center gap-2 px-3 py-1.5 rounded-lg border {% if active_nav == 'profile' %}border-cyan-400 bg-cyan-500/10{% else %}border-slate-700 hover:border-slate-500{% endif %} text-sm"
            >
              <span class="font-medium text-slate-200"
                >{{ user.full_name }}</span
              >
              <span
                class="px-2 py-0.5 text-xs rounded-full font-semibold {% if user.role == 'Admin' %}bg-amber-500/20 text-amber-300{% else %}bg-sky-500/20 text-sky-300{% endif %}"
